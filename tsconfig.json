{
  "compilerOptions": {
    // ES2021 matches the bundler's browser targets (Safari 15): newer
    // APIs like at(), findLast() and Object.hasOwn() fail the type check.
    "target": "es2021",
    "lib": ["es2021", "dom", "dom.iterable"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@huuma/ui",
    // JSR rejects slow types: exports need explicit types. `vp check`
    // doesn't report these errors; `vp run pack` does.
    "declaration": true,
    "isolatedDeclarations": true,
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["src", "test", "scripts", "vite.config.ts"],
  // Deno-only smoke tests, checked by `deno test`.
  "exclude": ["test/deno"]
}
